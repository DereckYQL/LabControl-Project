/*
  Cabeceras de seguridad para el hosting estatico (Cloudflare Pages).

  Cuando el sitio lo sirve el propio Express, las pone helmet en server.js. Al
  publicarlo como archivos estaticos, helmet deja de afectar al frontend, asi que
  hay que replicar aqui exactamente la misma politica: si no, la web quedaria sin
  CSP, sin proteccion contra iframes y sin restricción de permisos, mientras que
  las respuestas de /api (que si las pone el backend) seguirian protegiendas.

  Los valores son los mismos que helmet recibe en server.js. Si se cambia la CSP
  alli, hay que cambiarla tambien aqui.
*/

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-DNS-Prefetch-Control: off

# La API nunca se guarda en cache: son datos de sesion.
/api/*
  Cache-Control: no-store
