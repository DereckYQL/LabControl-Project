# Dependencias
node_modules/

# Base de datos generada en tiempo de ejecución
website/backend/database/*.db
website/backend/database/*.db-shm
website/backend/database/*.db-wal

# Clave JWT persistente generada en tiempo de ejecución
website/backend/database/.jwt-secret

# Artefactos de Playwright / tests
test-results/
playwright-report/
coverage/

# Estado local de Cloudflare Pages / Wrangler
.wrangler/

# Sistema / editor
*.log
Thumbs.db
.DS_Store